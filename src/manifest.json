{
  "manifest_version": 3,
  "name": "Miru",
  "version": "0.2.0",
  "description": "AI-driven browser agent for natural language instructions",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "https://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [],
  "action": {
    "default_title": "Open Miru",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
